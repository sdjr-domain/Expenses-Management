{% extends "base.html" %}

{% block title %}Dashboard — Spendly{% endblock %}
{% block page_name %}Dashboard{% endblock %}

{% block content %}
<div class="py-4">
    <header class="flex flex-col md:flex-row md:items-center justify-between mb-10 gap-6">
        <div>
            <h1 class="serif text-4xl text-slate-900 mb-2 leading-tight">Spending Overview</h1>
            <p class="text-slate-500 text-lg">Welcome back. Track your finances and spot spending patterns.</p>
        </div >
        <a href="{{ url_for('add_expense_route') }}" class="bg-slate-900 text-white px-6 py-3 rounded-full text-sm font-bold hover:bg-slate-800 transition-all shadow-lg shadow-slate-200 flex items-center justify-center gap-2 shrink-0 hover:-translate-y-0.5 active:translate-y-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Add Expense</span>
        </a>
    </header>

    <!-- Summary KPIs -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 bg-emerald-50 text-emerald-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div >
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Spending</p>
            </div >
            <p class="text-5xl font-bold text-slate-900 tracking-tight">₹{{ "%.2f"|format(summary.total_spend) }}</p>
        </div >
        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 bg-slate-50 text-slate-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V9a2 2 0 012-2z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2v6" />
                    </svg>
                </div >
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Top Category</p>
            </div >
            <p class="text-5xl font-bold text-slate-900 tracking-tight">{{ summary.top_category }}</p>
        </div >
        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 bg-slate-50 text-slate-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 000 4h12a2 2 0 000-4M9 5a2 2 0 012 0m2 0a2 2 0 012 0m2 0a2 2 0 012 0" />
                    </svg>
                </div >
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Transactions</p>
            </div >
            <p class="text-5xl font-bold text-slate-900 tracking-tight">{{ expenses|length }}</p>
        </div >
    </div >

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Category Breakdown -->
        <div class="lg:col-span-1">
            <h2 class="serif text-3xl text-slate-900 mb-8">Spending by Category</h2>
            <div class="space-y-3">
                {% for cat in categories %}
                <a href="{{ url_for('dashboard', category=cat.category) }}" class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl hover:border-emerald-200 hover:shadow-sm transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full {{ category_colors.get(cat.category, category_colors['Other']) }}"></div>
                        <span class="text-sm font-semibold text-slate-700 group-hover:text-slate-900">{{ cat.category }}</span>
                    </div >
                    <span class="text-sm font-bold text-slate-900">₹{{ "%.2f"|format(cat.total) }}</span>
                </a>
                {% endfor %}
                {% if not categories %}
                <div class="p-10 text-center bg-slate-50 border border-dashed border-slate-200 rounded-3xl">
                    <p class="text-sm text-slate-500 italic font-medium">No spending data available.</p>
                </div >
                {% endif %}
            </div >
        </div >

        <!-- Filterable Transactions -->
        <div class="lg:col-span-2">
            <div class="flex flex-col gap-6 mb-8">
                <div class="flex items-center justify-between">
                    <h2 class="serif text-3xl text-slate-900">Transactions</h2>

                    <div class="flex items-center gap-2 bg-white border border-slate-200 px-3 py-1.5 rounded-full shadow-sm">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Show</span>
                        <select name="limit" id="limit" onchange="this.closest('form').submit()" class="text-xs bg-transparent border-none p-0 text-slate-600 focus:ring-0 focus:outline-none cursor-pointer font-semibold">
                            {% for l in [20, 50, 100, 200, 500, 1000, 10000] %}
                            <option value="{{ l }}" {% if limit|string == l|string %}selected{% endif %}>{{ l }}</option>
                            {% endfor %}
                        </select>
                    </div >
                </div >

                <!-- Professional Toolstrip Filter -->
                <form method="GET" class="bg-white border border-slate-200 p-3 rounded-3xl shadow-sm flex flex-wrap items-center gap-3">
                    <div class="flex-1 min-w-[180px]">
                        <div class="relative">
                            <label class="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-400 uppercase tracking-widest pointer-events-none">Category</label>
                            <select name="category" class="w-full pl-16 pr-4 py-2.5 bg-slate-50 border border-transparent rounded-xl text-sm font-medium text-slate-700 focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all appearance-none cursor-pointer">
                                <option value="All" {% if request.args.get('category') == 'All' or not request.args.get('category') %}selected{% endif %}>All Categories</option>
                                {% for cat in user_categories %}
                                <option value="{{ cat.name }}" {% if request.args.get('category') == cat.name %}selected{% endif %}>{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div >
                    </div >

                    <div class="flex-1 min-w-[300px] flex items-center gap-3">
                        <div class="relative flex-1">
                            <label class="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-400 uppercase tracking-widest pointer-events-none">From</label>
                            <input type="date" name="start_date" value="{{ request.args.get('start_date', '') }}" class="w-full pl-12 pr-4 py-2.5 bg-slate-50 border border-transparent rounded-xl text-sm font-medium text-slate-700 focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all outline-none">
                        </div >
                        <div class="relative flex-1">
                            <label class="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-400 uppercase tracking-widest pointer-events-none">To</label>
                            <input type="date" name="end_date" value="{{ request.args.get('end_date', '') }}" class="w-full pl-12 pr-4 py-2.5 bg-slate-50 border border-transparent rounded-xl text-sm font-medium text-slate-700 focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all outline-none">
                        </div >
                    </div >

                    <div class="flex items-center gap-3 shrink-0">
                        <a href="{{ url_for('dashboard') }}" class="px-3 py-2.5 text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors">Reset</a>
                        <button type="submit" class="bg-slate-900 text-white px-6 py-2.5 rounded-xl text-sm font-bold hover:bg-slate-800 transition-all shadow-md shadow-slate-200 active:scale-95">Filter</button>
                    </div >
                </form>
            </div >

            <div class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
                <table class="w-full table-fixed text-left border-collapse">
                    <thead class="bg-slate-50/50 border-b border-slate-200">
                        <tr>
                            <th class="w-40 px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest whitespace-nowrap">
                                <a href="{{ url_for('dashboard', category=request.args.get('category'), start_date=request.args.get('start_date'), end_date=request.args.get('end_date'), sort='date_desc' if request.args.get('sort') == 'date_asc' else 'date_asc') }}" class="hover:text-slate-900 transition-colors inline-flex items-center gap-1">
                                    Date
                                    {% if request.args.get('sort') == 'date_asc' %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L10 7.414V15a1 1 0 11-2 0V7.414l-3.293 2.293a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                                    {% elif request.args.get('sort') == 'date_desc' %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L10 12.586V5a1 1 0 112 0v7.586l3.293 2.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                                    {% else %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 11.586l3.293-4.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                    {% endif %}
                                </a>
                            </th >
                            <th class="w-40 px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Category</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Description</th>
                            <th class="w-40 px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest text-right whitespace-nowrap">
                                <a href="{{ url_for('dashboard', category=request.args.get('category'), start_date=request.args.get('start_date'), end_date=request.args.get('end_date'), sort='amount_desc' if request.args.get('sort') == 'amount_asc' else 'amount_asc') }}" class="hover:text-slate-900 transition-colors inline-flex items-center justify-end gap-1">
                                    Amount
                                    {% if request.args.get('sort') == 'amount_asc' %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L10 7.414V15a1 1 0 11-2 0V7.414l-3.293 2.293a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                                    {% elif request.args.get('sort') == 'amount_desc' %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L10 12.586V5a1 1 0 112 0v7.586l3.293 2.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                                    {% else %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 11.586l3.293-4.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                    {% endif %}
                                </a>
                            </th >
                            <th class="w-32 px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest text-center">Actions</th>
                        </tr >
                    </thead >
                    <tbody class="divide-y divide-slate-100">
                        {% for expense in expenses %}
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="px-6 py-5 text-sm text-slate-500 whitespace-nowrap font-medium">{{ expense.date }}</td>
                            <td class="px-6 py-5">
                                <span class="text-[11px] font-bold px-2.5 py-1 rounded-full border {{ category_colors.get(expense.category, category_colors['Other']) }}">
                                    {{ expense.category }}
                                </span>
                            </td >
                            <td class="px-6 py-5 text-sm text-slate-600 truncate font-medium">{{ expense.description }}</td>
                            <td class="px-6 py-5 text-sm font-bold text-slate-900 text-right whitespace-nowrap">₹{{ "%.2f"|format(expense.amount) }}</td>
                            <td class="px-6 py-5 text-center whitespace-nowrap">
                                <div class="flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a href="{{ url_for('edit_expense', id=expense.id) }}" title="Edit expense" class="text-slate-400 hover:text-emerald-600 transition-colors p-1.5 rounded-lg hover:bg-emerald-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <form action="{{ url_for('delete_expense_route', id=expense.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this expense?');" class="inline">
                                        <button type="submit" title="Delete expense" class="text-slate-400 hover:text-red-500 transition-colors p-1.5 rounded-lg hover:bg-red-50">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>
                                </div >
                            </td >
                        </tr >
                        {% endfor %}
                        {% if not expenses %}
                        <tr>
                            <td colspan="5" class="px-6 py-20 text-center">
                                <div class="flex flex-col items-center gap-3">
                                    <div class="w-12 h-12 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center text-xl">
                                        ∅
                                    </div >
                                    <p class="text-slate-500 italic font-medium">No transactions found matching your filters.</p>
                                </div >
                            </td >
                        </tr >
                        {% endif %}
                    </tbody >
                </table >
            </div >
        </div >
    </div >
</div >
{% endblock %}
